rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    // Private creator files. Client SDK must not read or write.
    // Access is Admin SDK upload + short-lived backend signed URLs after auth + ownership.

    match /users/{userId}/{allPaths=**} {

      allow read, write: if false;

    }

    match /projects/{projectId}/{allPaths=**} {

      allow read, write: if false;

    }

    match /exports/{userId}/{allPaths=**} {

      allow read, write: if false;

    }

  }

}
