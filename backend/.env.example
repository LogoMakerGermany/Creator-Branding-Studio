# =============================================================================
# SERVER SECRETS — Railway Variables ONLY (never commit backend/.env)
# =============================================================================
# Copy to backend/.env for local development only.
# Production: configure all secrets in Railway → Service → Variables
# See docs/SECURITY.md
# =============================================================================

# Server

PORT=3001

NODE_ENV=production

# Serve frontend/dist from this process (Railway Docker / single-container deploy)
SERVE_STATIC=true



# Firebase Admin (required for production)

FIREBASE_PROJECT_ID=your-project-id

FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

FIREBASE_STORAGE_BUCKET=your-project.appspot.com



# Stripe Live (sk_live_...) or Test (sk_test_...)

STRIPE_SECRET_KEY=sk_live_...

STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Stripe Price IDs (recommended for Live)

STRIPE_PRICE_STARTER=price_...

STRIPE_PRICE_PRO=price_...

STRIPE_PRICE_ULTIMATE=price_...

# PayPal (sandbox or live)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox


# AI Providers

OPENAI_API_KEY=

REPLICATE_API_TOKEN=

# Text-to-Video (Replicate model slug, default: minimax/video-01)
REPLICATE_VIDEO_MODEL=minimax/video-01

RUNWAY_API_KEY=

ELEVENLABS_API_KEY=

SUNO_API_KEY=



# Frontend URLs (comma-separated for multiple origins)

FRONTEND_URL=https://app.deine-domain.de

FRONTEND_URLS=https://app.deine-domain.de,https://www.deine-domain.de



# Public client config (Railway all-in-one / SERVE_STATIC=true)
# Same values as Firebase Web App + Stripe publishable key — safe to expose in browser

PUBLIC_FIREBASE_API_KEY=

PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

PUBLIC_FIREBASE_PROJECT_ID=your-project-id

PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

PUBLIC_FIREBASE_APP_ID=

PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...



# RTMP / Live Streaming (e.g. nginx-rtmp, Mux, Cloudflare Stream)

RTMP_SERVER_URL=rtmp://live.deine-domain.de/live

RTMP_APP_NAME=live

RTMP_PROVIDER=nginx-rtmp

# HLS playback — use {streamKey} placeholder or demo stream in dev

# HLS_PLAYBACK_BASE_URL=https://stream.deine-domain.de/hls/{streamKey}/index.m3u8

# HLS_DEMO_PLAYBACK_URL=https://devstreaming-cdn.apple.com/videos/streaming/examples/bipbop_16x9/bipbop_16x9_variant.m3u8

# HLS_USE_DEMO=false



# Production: NEVER set DEV_AUTH_BYPASS — app will refuse to start if enabled

# DEV_AUTH_BYPASS=true   # LOCAL DEVELOPMENT ONLY



DEFAULT_FREE_COINS=50

