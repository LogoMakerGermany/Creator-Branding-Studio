# =============================================================================
# SERVER SECRETS — Railway Variables ONLY (never commit backend/.env)
# Copy to backend/.env for local development only.
# Production: configure all secrets in Railway → Service → Variables
# See docs/SECURITY.md and docs/PRODUCTION_RUNBOOK.md
#
# Classification:
#   REQUIRED            — process will not start in production without these
#   OPTIONAL            — core V1 works without them
#   FEATURE-DEPENDENT   — needed only if that feature is used
#   DEV ONLY            — must NEVER be enabled in production
# =============================================================================

# --- Server (REQUIRED) ---
PORT=3001
NODE_ENV=production
# Serve frontend/dist from this process (Railway Docker / single-container deploy)
SERVE_STATIC=true

# --- Firebase Admin (REQUIRED in production) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# OPTIONAL
# FIREBASE_DATABASE_URL=

# --- Frontend URLs / CORS (REQUIRED in production: FRONTEND_URL or FRONTEND_URLS) ---
FRONTEND_URL=https://app.deine-domain.de
FRONTEND_URLS=https://app.deine-domain.de,https://www.deine-domain.de

# --- Public client config (REQUIRED when SERVE_STATIC=true) ---
# Same values as Firebase Web App + Stripe publishable key — safe to expose in browser
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# --- Stripe (REQUIRED for coin purchases in production) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# OPTIONAL: Stripe Price IDs (recommended for Live)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ULTIMATE=price_...

# --- PayPal (FEATURE-DEPENDENT: only if PayPal checkout is offered) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# FEATURE-DEPENDENT and REQUIRED when PayPal is configured in production
PAYPAL_WEBHOOK_ID=

# --- Email / Resend (FEATURE-DEPENDENT: transactional mail; app runs without it) ---
RESEND_API_KEY=
EMAIL_FROM=NEXTER <noreply@deine-domain.de>

# --- AI Providers ---
# REQUIRED in production: at least one of OPENAI_API_KEY or REPLICATE_API_TOKEN (image)
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
# OPTIONAL / FEATURE-DEPENDENT
REPLICATE_VIDEO_MODEL=minimax/video-01
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=
SUNO_API_KEY=
# OPTIONAL
# GEMINI_API_KEY=

# --- Welcome coins (OPTIONAL, default 50). Tester +500 is a separate admin grant. ---
DEFAULT_FREE_COINS=50

# --- Registration (OPTIONAL, default invite_only) ---
REGISTRATION_MODE=invite_only

# --- Pricing / cost protection (OPTIONAL) ---
PRICE_QUOTE_TTL_MINUTES=15
GENERATIONS_ENABLED=true
IMAGE_GENERATIONS_ENABLED=true
VIDEO_GENERATIONS_ENABLED=true
PAYMENTS_ENABLED=true
MAX_DAILY_JOBS_PER_USER=50
MAX_CONCURRENT_JOBS_PER_USER=3
# FEATURE-DEPENDENT cost caps
# DAILY_PROVIDER_BUDGET_CENTS=50000
# MAX_DAILY_PROMOTIONAL_SPEND_CENTS=10000

# --- RTMP / Live (FEATURE-DEPENDENT: Live is not a V1 product surface) ---
RTMP_SERVER_URL=rtmp://live.deine-domain.de/live
RTMP_APP_NAME=live
RTMP_PROVIDER=nginx-rtmp
# HLS_PLAYBACK_BASE_URL=https://stream.deine-domain.de/hls/{streamKey}/index.m3u8
# HLS_DEMO_PLAYBACK_URL=https://devstreaming-cdn.apple.com/videos/streaming/examples/bipbop_16x9/bipbop_16x9_variant.m3u8
# HLS_USE_DEMO=false

# --- DEV ONLY — Production refuses to start if DEV_AUTH_BYPASS=true ---
# DEV_AUTH_BYPASS=true
