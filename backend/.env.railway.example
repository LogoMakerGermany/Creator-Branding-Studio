# =============================================================================
# RAILWAY PRODUCTION — copy to backend/.env.railway and fill in values
# NEVER commit backend/.env.railway (gitignored)
# Sync to Railway: npm run railway:vars
# =============================================================================

NODE_ENV=production
SERVE_STATIC=true
PORT=3001

# After first deploy: your Railway public URL (no trailing slash)
FRONTEND_URL=https://your-app.up.railway.app
FRONTEND_URLS=https://your-app.up.railway.app

# Firebase Admin (Service Account JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Firebase Web App (public — same as Firebase Console → Web app)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Stripe Live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTIMATE=
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI (at least one required)
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# Optional
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
DEFAULT_FREE_COINS=50

# NEVER in production:
# DEV_AUTH_BYPASS=true
