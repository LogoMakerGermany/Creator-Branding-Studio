rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    match /users/{userId} {

      allow read: if request.auth != null && request.auth.uid == userId;

      // Testers/Admins and all profile fields (role, coinBalance, balanceCents,
      // disabled, subscriptionTier, nexterPreferences, onboarding) are written
      // only via Admin SDK / authenticated API. Client SDK must not patch the user doc.

      allow create, update, delete: if false;

    }

    match /creator_dna/{dnaId} {

      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Writes go through the Admin SDK / authenticated API. Client SDK must not mutate DNA.

      allow create, update, delete: if false;

    }

    match /projects/{projectId} {

      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // Writes go through the Admin SDK / authenticated API. Client SDK must not mutate projects.

      allow create, update, delete: if false;

    }

    match /coin_transactions/{txId} {

      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      allow write: if false;

    }

    match /processedStripeSessions/{sessionId} {

      allow read, write: if false;

    }

    match /processedPayPalOrders/{orderId} {

      allow read, write: if false;

    }

    match /files/{fileId} {

      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      allow write: if false;

    }

    match /generationJobs/{jobId} {

      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      allow write: if false;

    }

    match /mediaJobs/{jobId} {

      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      allow write: if false;

    }

    match /layouts/{layoutId} {

      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Writes go through the Admin SDK / authenticated API. Client SDK must not mutate layouts.

      allow create, update, delete: if false;

    }

    match /marketplace_items/{itemId} {

      allow read, write: if false;

    }

    match /{document=**} {

      allow read, write: if false;

    }

  }

}
