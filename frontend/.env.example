# =============================================================================
# PUBLIC CLIENT CONFIG ONLY — safe to expose in the browser bundle
# Server secrets (OpenAI, Stripe secret, Firebase private key) → Railway only
# See docs/SECURITY.md
# =============================================================================

# Firebase Client (required for production auth)

VITE_FIREBASE_API_KEY=

VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

VITE_FIREBASE_PROJECT_ID=your-project-id

VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

VITE_FIREBASE_MESSAGING_SENDER_ID=

VITE_FIREBASE_APP_ID=



# API – LEER LASSEN für reine Web-App (Frontend + API auf derselben Domain, z. B. Railway)

# Nur bei Split-Deploy setzen: VITE_API_URL=https://api.deine-domain.de

VITE_API_URL=



# Stripe Publishable Key (pk_live_... or pk_test_...)

VITE_STRIPE_PUBLISHABLE_KEY=

