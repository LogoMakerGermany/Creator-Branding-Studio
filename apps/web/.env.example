# Frontend Environment (öffentliche Werte only)
# Kopiere nach apps/web/.env.local für lokale Entwicklung.
# Production: Build-Zeit-Variablen in Railway/Vite setzen.

# Backend-URL (Production: https://deine-api.railway.app)
VITE_API_URL=

# Stripe Publishable Key (pk_...) – niemals Secret Key
VITE_STRIPE_PUBLISHABLE_KEY=

# Firebase Web Config (öffentlich, OK im Frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
